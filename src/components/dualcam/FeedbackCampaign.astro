---
import { locales } from '../../lib/dualcam-showcase/locales.mjs';
import { campaignCopy } from '../../lib/dualcam-showcase/campaign-copy.mjs';
import { campaignDate, campaignDeadline, campaignEndTime, campaignTimeLeft } from '../../lib/dualcam-showcase/campaign-time.mjs';
import initial from '../../data/dualcam-campaign-availability.json';

const { locale } = Astro.props;
const copy = campaignCopy(locale);
const format = locales[locale].format;
const market = locale === 'zh-Hans' ? 'cn' : 'intl';
const store = {
  cn: 'https://apps.apple.com/cn/app/id6774681432',
  intl: 'https://apps.apple.com/app/id6774681432',
};
const profiles = {
  cn: {url: 'https://www.xiaohongshu.com/user/profile/692d5fe3000000003702eff9', name: '小红书'},
  intl: {url: 'https://x.com/pineapple201805', name: 'DinoAI · X'},
};
const markets = [{id:'cn', anchor:'cn-feedback', label:copy.mainland}, {id:'intl', anchor:'international-feedback', label:copy.overseas}];
const now = Date.now();
const ended = now >= campaignEndTime;
const soldOut = initial[market] === 0;
const countText = (count) => copy.remaining.replace('{n}', new Intl.NumberFormat(format).format(count));
---
<section class="membership" aria-labelledby="membership-title"
  data-membership
  data-format={format}
  data-market={market}
  data-stock={JSON.stringify(initial)}
  data-remaining={copy.remaining}
  data-closed={copy.closed}
  data-sold-out={copy.soldOut}>
  <div class="membership-head">
    <h2 id="membership-title">{copy.title}</h2>
    <div class="membership-counts">
      <span class="time-label" data-countdown-group hidden={ended}>{copy.countdown} <strong data-countdown dir="auto">{ended ? copy.closed : campaignTimeLeft(now,format)}</strong></span>
      <strong data-remaining-count>{ended ? copy.closed : soldOut ? copy.soldOut : countText(initial[market])}</strong>
    </div>
  </div>
  <div class="membership-locations" aria-label={copy.claim}>
    {markets.map(option => (
      <a href={'#'+option.anchor} data-market-link={option.id} aria-current={option.id===market ? 'true' : undefined}>{option.label}</a>
    ))}
  </div>

  {markets.map(option => (
    <div class="membership-flow" id={option.anchor} data-campaign-market={option.id} hidden={option.id!==market}>
      <ol>
        <li>
          <h3>{copy.download}</h3>
          <a class="membership-action" href={store[option.id]} data-store-link data-placement="giveaway" target="_blank" rel="noreferrer">App Store <span aria-hidden="true">↗</span></a>
        </li>
        <li>
          <h3>{copy.claim}</h3>
          <div data-campaign-claim hidden={ended || initial[option.id]===0}>
            {option.id === 'cn'
              ? <p>{copy.onXiaohongshu} <strong lang="zh-Hans" dir="ltr">「双摄终身免费」</strong></p>
              : <p>{copy.onX}</p>}
            <a class="membership-action profile" href={profiles[option.id].url} target="_blank" rel="noreferrer" lang={option.id==='cn'?'zh-Hans':undefined}>{profiles[option.id].name} <span aria-hidden="true">↗</span></a>
          </div>
          <p data-campaign-inactive hidden={!ended && initial[option.id]!==0}>{ended ? copy.closed : copy.soldOut}</p>
        </li>
        <li>
          <h3>{copy.redeem}</h3>
          <p>{copy.redeemHelp}</p>
          <a class="membership-action" href="/dualcam/media/redemption-guide-zh.webp" hreflang="zh-Hans" target="_blank" rel="noreferrer">{copy.guide} <span aria-hidden="true">↗</span></a>
        </li>
      </ol>
    </div>
  ))}
  <div class="membership-foot">
    <span>{copy.ends} <time datetime={campaignDeadline}>{campaignDate(campaignDeadline,format)}</time></span>
    <span>{copy.updated} <time datetime={initial.updatedAt} data-stock-time>{campaignDate(initial.updatedAt,format)}</time></span>
  </div>
</section>

<script>
  import { campaignDate, campaignEndTime, campaignTimeLeft } from '../../lib/dualcam-showcase/campaign-time.mjs';

  const root = document.querySelector<HTMLElement>('[data-membership]');
  if (root) {
    const locale = root.dataset.format!;
    const period = root.querySelector<HTMLElement>('[data-countdown]')!;
    const countdownGroup = root.querySelector<HTMLElement>('[data-countdown-group]')!;
    const quantity = root.querySelector<HTMLElement>('[data-remaining-count]')!;
    const timestamp = root.querySelector<HTMLTimeElement>('[data-stock-time]')!;
    let stock = JSON.parse(root.dataset.stock!);
    let current = root.dataset.market!;

    function render() {
      const now = Date.now();
      const closed = now >= campaignEndTime;
      const count = stock[current];
      const status = closed ? root!.dataset.closed! : root!.dataset.soldOut!;
      countdownGroup.hidden = closed;
      period.textContent = closed ? status : campaignTimeLeft(now,locale);
      quantity.textContent = closed || count === 0 ? status
        : root!.dataset.remaining!.replace('{n}', new Intl.NumberFormat(locale).format(count));
      root!.querySelectorAll<HTMLElement>('[data-campaign-market]').forEach(panel => {
        const market = panel.dataset.campaignMarket!;
        const open = !closed && stock[market] > 0;
        panel.hidden = market !== current;
        panel.querySelector<HTMLElement>('[data-campaign-claim]')!.hidden = !open;
        const inactive = panel.querySelector<HTMLElement>('[data-campaign-inactive]')!;
        inactive.hidden = open;
        if (!open) inactive.textContent = closed ? root!.dataset.closed! : root!.dataset.soldOut!;
      });
      root!.querySelectorAll<HTMLAnchorElement>('[data-market-link]').forEach(link => {
        if (link.dataset.marketLink === current) link.setAttribute('aria-current','true');
        else link.removeAttribute('aria-current');
      });
      timestamp.dateTime = stock.updatedAt;
      timestamp.textContent = campaignDate(stock.updatedAt,locale);
    }

    async function refreshStock() {
      if (Date.now() >= campaignEndTime) return;
      try {
        const minute = Math.floor(Date.now()/60_000);
        const response = await fetch('/dualcam/campaign-availability.json?v='+minute, {signal: AbortSignal.timeout(5_000)});
        if (!response.ok) return;
        const latest = await response.json();
        if (
          [latest?.cn, latest?.intl].every(value => Number.isInteger(value) && value >= 0 && value <= 100)
          && Number.isFinite(Date.parse(latest.updatedAt))
          && Date.parse(latest.updatedAt) >= Date.parse(stock.updatedAt)
        ) {
          stock = latest;
          render();
        }
      } catch {
        // The last published stock remains visible with its original timestamp.
      }
    }

    function selectFromHash() {
      if (location.hash === '#international-feedback') current = 'intl';
      if (location.hash === '#cn-feedback') current = 'cn';
      render();
    }
    root.querySelectorAll<HTMLAnchorElement>('[data-market-link]').forEach(link => {
      link.addEventListener('click', event => {
        event.preventDefault();
        current = link.dataset.marketLink!;
        history.replaceState(null, '', link.hash);
        render();
      });
    });
    window.addEventListener('hashchange', selectFromHash);
    selectFromHash();
    if (location.hash === '#cn-feedback' || location.hash === '#international-feedback') {
      requestAnimationFrame(() => root.scrollIntoView({block:'start'}));
    }
    void refreshStock();
    setInterval(render, 15_000);
    setInterval(() => void refreshStock(), 60_000);
  }
</script>

<style>
  .membership{max-inline-size:1060px;margin:26px auto 0;padding:19px 23px 15px;background:#f7f9ff;border:1px solid #dde5fc;border-radius:19px;text-align:start;scroll-margin-top:82px}
  .membership-head,.membership-counts,.membership-locations,.membership-foot{display:flex;align-items:center;flex-wrap:wrap;gap:8px 16px}
  .membership-head,.membership-foot{justify-content:space-between}
  .membership-head h2{margin:0;font-size:clamp(21px,3.05vw,33px);line-height:1.2;font-weight:720;letter-spacing:-.025em;text-wrap:balance}
  .membership-counts,.membership-foot{font-size:13px;color:var(--muted)}
  .membership-counts strong{color:var(--ink);font-variant-numeric:tabular-nums}
  .membership-counts [data-remaining-count]{color:#2049ad;background:#e8efff;border-radius:999px;padding:3px 10px;white-space:nowrap}
  .membership-locations{gap:4px;margin-block:12px 8px}
  .membership-locations a{padding:5px 10px;border-radius:7px;color:var(--muted);font-size:13px;font-weight:620}
  .membership-locations a:hover,.membership-locations a[aria-current=true]{color:#2049ad;background:#e8efff}
  .membership-locations a:focus-visible,.membership-action:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .membership-flow[hidden],[data-campaign-claim][hidden],[data-campaign-inactive][hidden]{display:none}
  .membership-flow ol{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr) minmax(0,1.65fr);gap:10px;margin:0;padding:0;list-style:none}
  .membership-flow li{padding:12px 14px;background:white;border:1px solid #e3e8f4;border-radius:11px;min-inline-size:0}
  .membership-flow h3{font-size:15px;line-height:1.3;margin:0 0 5px}
  .membership-flow p{font-size:13px;line-height:1.5;color:#454a59;margin:0}
  .membership-action{display:inline-block;margin-block-start:5px;color:#2049ad;text-decoration:underline;text-underline-offset:3px;font-size:13px;font-weight:650;max-inline-size:100%}
  .membership-action.profile{background:#e9efff;border-radius:7px;text-decoration:none;padding:4px 9px}
  .membership-foot{border-block-start:1px solid #dde5f7;margin-block-start:10px;padding-block-start:8px;font-size:11px}
  @media (max-width:680px) {
    .membership{margin-block-start:20px;padding:14px 12px 10px;border-radius:13px}
    .membership-flow ol{grid-template-columns:minmax(0,1fr);gap:6px}
    .membership-flow li{padding:8px 10px}
    .membership-flow h3{margin-block-end:2px}
    .membership-head{row-gap:7px}
  }
</style>
