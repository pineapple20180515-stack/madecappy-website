---
import Layout from '../../layouts/DualCamMarketingLayout.astro';
import PublishedDemos from './PublishedDemos.astro';
import releases from '../../data/dualcam-version-23.json';
import duo from '../../data/dualcam-duo-guide.json';
import copy from '../../data/dualcam-marketing.json';
interface Props {locale:keyof typeof copy;}
const {locale}=Astro.props;const d=copy[locale];const guide=duo[locale];
const releaseUrl=locale==='zh'?'/dualcam/releases/2.3/':`/dualcam/${locale}/releases/2.3/`;
const duoUrl=locale==='zh'?'/dualcam/iphone-duo/':`/dualcam/${locale}/iphone-duo/`;
const demoHeading={zh:'看一次前后双摄怎么拍',en:'See how to film both sides',th:'ดูวิธีถ่ายด้วยกล้องคู่'}[locale];
const demoNote={zh:'场景为 AI 演绎，操作段使用 DualCam 界面。',en:'Illustrative AI scenes edited with the DualCam interface.',th:'ฉากสร้างด้วย AI ตัดต่อร่วมกับหน้าจอ DualCam'}[locale];
const releaseNote={zh:'此处展示 DualCam 2.3。App Store 下载页显示当前地区可用版本。',en:'This page previews DualCam 2.3. Check the App Store for the version available in your region.',th:'หน้านี้แสดงตัวอย่าง DualCam 2.3 ตรวจสอบเวอร์ชันที่เปิดให้ดาวน์โหลดใน App Store ของคุณ'}[locale];
const names=['photo','live','video','layouts','postcard','prompter'];
const slugs=['record-front-back','choose-a-layout'];
const store=locale==='th'?'https://apps.apple.com/th/app/id6774681432':'https://apps.apple.com/app/id6774681432';
---
<Layout locale={locale}>
<section class="hero wrap">
<div class="hero-copy"><p class="eyebrow">{d.badge}</p><h1>{d.headline[0]}<br/><span>{d.headline[1]}</span></h1><p class="intro">{d.intro}</p><a class="button primary" href={store} data-store-link data-placement="hero">{d.download}<span aria-hidden="true">↗</span></a><p class="compat">{d.compat}</p><p class="small-note">{releaseNote}</p><a class="text-link" href={duoUrl}>{guide.linkTitle}</a><div><a class="text-link" href={releaseUrl}>{releases[locale].label}</a></div><a class="text-link" href="#thai-demos">{d.watch} <span aria-hidden="true">↓</span></a></div>
<figure class="hero-visual"><img src={`/dualcam/media/camera-29-${locale}.webp`} width="1179" height="2556" alt={d.shots[0]} fetchpriority="high"/><figcaption>{d.imageNote}</figcaption></figure>
</section>
<section class="section wrap" id="quick-demo">
  <div class="section-intro"><h2>{demoHeading}</h2><p>{demoNote}</p></div>
  <video controls playsinline preload="none" class="launch-clip" width="1280" height="720" poster="/dualcam/media/release-23/dualcam-field-demo.webp" data-demo-id="dualcam-23" aria-label={demoHeading}>
    <source src="/dualcam/media/release-23/dualcam-field-demo.mp4" type="video/mp4"/>
    <track kind="captions" srclang="zh-Hans" label="简体中文" src="/dualcam/media/release-23/dualcam-field-demo-zh.vtt" default={locale==='zh'}/>
    <track kind="captions" srclang="en" label="English" src="/dualcam/media/release-23/dualcam-field-demo-en.vtt"/>
    <track kind="captions" srclang="th" label="ไทย" src="/dualcam/media/release-23/dualcam-field-demo-th.vtt" default={locale==='th'}/>
  </video>
</section>
<PublishedDemos locale={locale}/>
<section class="section wrap" id="features"><div class="section-intro"><h2>{d.galleryTitle}</h2><p>{d.galleryIntro}</p></div><div class="gallery">{names.map((name,i)=><figure><img src={`/dualcam/media/ui29-${locale}-${name}.webp`} width="720" height="1561" alt={d.shots[i]} loading="lazy"/><figcaption>{d.shots[i]}</figcaption></figure>)}</div><p class="small-note">{d.imageNote}</p></section>
<section class="demo-section" id="demo"><div class="wrap demo-grid"><div><h2>{d.demoTitle}</h2><p>{d.demoText}</p><details class="transcript"><summary>{d.transcriptLabel}</summary><ol>{d.demoTranscript.map(t=><li>{t}</li>)}</ol></details></div><video controls playsinline preload="none" poster="/dualcam/media/video-poster.jpg" width="664" height="1440" aria-label={d.demoTitle}><source src="/dualcam/media/layout-demo.mp4" type="video/mp4"/><a href="/dualcam/media/layout-demo.mp4">{d.watch}</a></video></div></section>
<section class="section wrap"><h2>{d.featuresTitle}</h2><div class="features">{d.features.map(([title,text])=><article><h3>{title}</h3><p>{text}</p></article>)}</div></section>
<section class="section wrap" id="updates"><h2>{d.updateTitle}</h2><p><a class="text-link" href={releaseUrl}>{releases[locale].label}</a></p><div class="features">{d.updates.map(([title,text])=><article><h3>{title}</h3><p>{text}</p></article>)}</div></section>
<section class="section wrap" id="guides"><div class="section-intro"><h2>{d.guideTitle}</h2><p>{d.guideIntro}</p></div><div class="guides"><a class="guide-card" href={duoUrl}><h3>{guide.linkTitle}</h3><p>{guide.linkDescription}</p><span class="text-link">{d.read}</span></a>{d.guides.map(([title,text],i)=><a class="guide-card" href={`/dualcam/${locale}/guides/${slugs[i]}/`}><span class="guide-number">0{i+1}</span><h3>{title}</h3><p>{text}</p><span class="text-link">{d.read} →</span></a>)}</div></section>
<section class="pricing-section"><div class="wrap pricing-grid"><div><h2>{d.pricingTitle}</h2><p>{d.pricingText}</p></div><div><div class="plans">{d.plans.map(([title,text])=><div><h3>{title}</h3><p>{text}</p></div>)}</div><p class="small-note">{d.priceNote}</p></div></div></section>
<section class="section wrap faq" id="faq"><h2>{d.faqTitle}</h2>{d.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
<section class="bottom-cta wrap"><h2>{d.bottomTitle}</h2><a class="button primary" href={store} data-store-link data-placement="footer">{d.download}<span aria-hidden="true">↗</span></a></section>
</Layout>

<style>.launch-clip{width:100%;max-width:960px;height:auto;display:block;border-radius:18px;background:#14222b}</style>
