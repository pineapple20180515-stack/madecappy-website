---
import published from '../../data/dualcam-published-videos.json';
interface Props { locale: keyof typeof published.copy; }
const {locale}=Astro.props;
const d=published.copy[locale];
---
<section class="section wrap published-demos" id="thai-demos" aria-labelledby="published-demos-title">
  <div class="section-intro"><h2 id="published-demos-title">{d.title}</h2><p>{d.intro}</p></div>
  <p class="demo-disclosure">{d.note}</p>
  <div class="published-demo-grid">
    {published.videos.map(video=><article class="published-demo-card">
      <p class="demo-badge">{d.badge}</p>
      <video controls playsinline preload="none" poster={video.poster} width="720" height="1280" aria-label={`${d.play}: ${video.title[locale]}`} data-demo-id={video.id}>
        <source src={video.src} type="video/mp4"/>
        <a href={video.src}>{d.play}</a>
      </video>
      <h3>{video.title[locale]}</h3><p>{video.description[locale]}</p>
      <nav class="demo-published-links" aria-label={video.title[locale]}>
        <a href={video.youtube} target="_blank" rel="noopener noreferrer">{d.youtube} ↗</a>
        <a href={video.x} target="_blank" rel="noopener noreferrer">{d.x} ↗</a>
      </nav>
    </article>)}
  </div>
</section>
