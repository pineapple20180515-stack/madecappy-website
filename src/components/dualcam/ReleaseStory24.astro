---
import copy from '../../data/dualcam-version-24.json';
import developmentNotes from '../../data/dualcam-24-notes.json';
import {release24Editorial} from '../../data/dualcam-24-editorial.mjs';
import {release24Locales, release24Media, release24Path} from '../../lib/dualcam-release-24.mjs';
import '../../styles/dualcam-marketing.css';
import Attribution from './Attribution.astro';
import ReleaseDemo from './ReleaseDemo24.astro';
import ReleaseGallery from './ReleaseGallery24.astro';
import ReleaseNotes from './ReleaseNotes.astro';
import {getCopy} from '../../lib/dualcam-showcase/copy.js';

interface Props { locale: keyof typeof copy; }
const {locale} = Astro.props;
const d = copy[locale];
const e = release24Editorial[locale];
const routes = release24Locales[locale];
const titleLines=locale.startsWith('zh-') ? d.title.split(/(?<=，)/) : [d.title];
const url = new URL(release24Path(locale), Astro.site).href;
const title = `DualCam 2.4 | ${d.title}`;
const image = new URL(`${release24Media}${locale}-share.jpg`, Astro.site).href;
const notes=developmentNotes[locale === 'en-GB' ? 'en-US' : locale];
const relatedFaq=getCopy(locale).editorial;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {'@type': 'Article', headline: title, description: d.description, datePublished: '2026-11-23',
      inLanguage: locale, mainEntityOfPage: url, image, articleSection: [...notes.map(note => note.title), ...d.features.map(([heading])=>heading)],
      author: {'@type': 'Organization', name: 'DualCam', url: new URL('/dualcam/', Astro.site).href}},
    {'@type': 'BreadcrumbList', itemListElement: [
      {'@type':'ListItem',position:1,name:'DualCam',item:new URL(routes.home,Astro.site).href},
      {'@type':'ListItem',position:2,name:'DualCam 2.4',item:url},
    ]},
  ],
};
---
<!doctype html>
<html lang={locale} dir={routes.dir || 'ltr'}>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title}</title>
    <meta name="description" content={d.description}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta property="og:type" content="article"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={d.description}/>
    <meta property="og:url" content={url}/>
    <meta property="og:image" content={image}/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <link rel="icon" href="/dualcam/icon.png"/>
    <link rel="canonical" href={url}/>
    {Object.keys(release24Locales).map(language => <link rel="alternate" hreflang={language} href={new URL(release24Path(language), Astro.site).href}/>)}
    <link rel="alternate" hreflang="x-default" href={new URL(release24Path('en-US'), Astro.site).href}/>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav-row">
        <a class="brand" href={routes.home}><img src="/dualcam/icon.png" alt="" width="32" height="32"/>DualCam</a>
        <details class="language-menu">
          <summary aria-label={e.language}>{routes.label}</summary>
          <nav class="languages" aria-label={e.language}>
            {Object.entries(release24Locales).map(([language, value]) =>
              <a href={release24Path(language)} lang={language} hreflang={language} aria-current={language === locale ? 'page' : undefined}>{value.label}</a>
            )}
          </nav>
        </details>
      </div>
    </header>
    <main class="wrap release" id="main">
      <article>
        <header class="release-hero">
          <div>
            <p class="eyebrow">DUALCAM 2.4</p>
            <h1>{titleLines.map(line=><span>{line}</span>)}</h1>
            <p class="lead">{d.intro}</p>
            <a class="button primary" href="https://apps.apple.com/app/id6774681432" data-store-link data-placement="release-24">{d.store}</a>
            <p class="availability">{d.availability}</p>
          </div>
          <section class="hero-demo" id="demo" aria-labelledby="demo-title">
            <h2 id="demo-title" class="sr-only">{e.demo}</h2>
            <ReleaseDemo locale={locale}/>
          </section>
        </header>
        <nav class="chapter-links" aria-label="DualCam 2.4">
          <a href="#demo">{e.demo}</a>
          <a href="#store-screenshots">{e.gallery}</a>
          <a href="#development">{e.notes}</a>
        </nav>
        <div class="features">
          {d.features.map(([heading, text]) => <section><h2>{heading}</h2><p>{text}</p></section>)}
        </div>
        <p class="trial">{d.trial}</p>
        <ReleaseGallery locale={locale}/>
        <ReleaseNotes title={e.notes} entries={notes} longform/>
        <section class="devices" aria-labelledby="device-title">
          <h2 id="device-title">{d.devicesTitle}</h2>
          <p>{d.devices}</p>
          <h3>{relatedFaq.faqDevices}</h3>
          <p>{relatedFaq.faqDevicesAnswer}</p>
        </section>
      </article>
    </main>
    <footer class="site-footer"><div class="wrap footer-row"><a href={routes.home}>{d.home}</a><a href={routes.archive}>{d.previous}</a></div></footer>
    <Attribution/>
  </body>
</html>
<style>
  .release { padding-block: clamp(30px, 7vw, 90px) 64px; }
  .release-hero { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); gap: clamp(20px, 6vw, 80px); align-items: center; }
  .release h1 { color: #f5f4ed; font-size: clamp(2.25rem, 5.1vw, 5rem); line-height: 1.12; margin: 14px 0 20px; letter-spacing: -.035em; overflow-wrap: anywhere; }
  .eyebrow { color: #e8bf5b; }
  .lead { font-size: clamp(1.04rem, 1.7vw, 1.24rem); line-height: 1.65; margin: 0 0 22px; }
  .availability { color: #bcc5bf; font-size: .87rem; margin: 14px 0 0; }
  .hero-demo { min-width: 0; }
  .hero-demo .sr-only { position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap; }
  .release h1 span { display:block;text-wrap:balance; }
  .chapter-links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-block-start: 28px; padding-block: 10px; border-bottom: 1px solid #374039; }
  .chapter-links a { color: #e6dcbb; font-size: .92rem; text-underline-offset: 3px; }
  .features { padding-block-start: 22px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .features h2,.devices h2 { font-size: 1.18rem; color: #f5f4ed; margin: 0 0 7px; }
  .features p,.devices p { margin: 0; }
  .trial { margin: 24px 0 32px; border-inline-start: 3px solid #e8bf5b; padding: 10px 13px; color: #e9ddbb; background: #171711; }
  .devices { border-top: 1px solid #374039; margin-block-start: 32px; padding-block-start: 20px; }
  .devices h3 { margin: 14px 0 6px; font-size: 1rem; }
  .language-menu { position: relative; z-index: 10; }
  .language-menu summary { display: flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 10px; cursor: pointer; font-size: .9rem; }
  .language-menu summary::after { position: static; inline-size: 1em; text-align: center; font-size: 1.05rem; }
  .language-menu .languages { position: absolute; z-index: 22; inset-inline-end: 0; inset-block-start: 100%; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); width: min(86vw,300px); gap: 3px; padding: 8px; background: #202622; border: 1px solid #424b45; border-radius: 12px; box-shadow: 0 12px 32px #0008; }
  .language-menu .languages a { font-size: .85rem; padding: 6px; overflow-wrap: anywhere; }
  :where(#demo,#store-screenshots,#development) { scroll-margin-block-start: 86px; }
  :global(html[dir="rtl"]) .release h1 { letter-spacing: normal; }
  @media (max-width: 760px) {
    .release-hero,.features { grid-template-columns: 1fr; }
  }
</style>
