---
import Layout from '../../layouts/DualCamMarketingLayout.astro';
import copy from '../../data/dualcam-version-23.json';
import ReleaseNotes from './ReleaseNotes.astro';

interface Props { locale: keyof typeof copy }
const {locale} = Astro.props;
const d = copy[locale];
const home = locale==='zh' ? '/dualcam/' : `/dualcam/${locale}/`;
const media = '/dualcam/media/release-23/';
const sections = [
  {key:'khmer', copy:d.language, images:['khmer-camera','khmer-settings']},
  {key:'duo', copy:d.duo, images:['duo-outer','duo-inner']},
  {key:'camera', copy:d.camera, images:[`layouts-${locale}`,`live-${locale}`]},
];
---
<Layout locale={locale} guide="release-2-3" title={d.title} description={d.description} socialImage={media+'front-scene.webp'}>
  <article class="release-story wrap">
    <header class="release-hero">
      <div>
        <a class="text-link" href={home}>{d.back}</a>
        <p class="eyebrow">{d.label}</p>
        <h1>{d.heading}</h1>
        <p class="intro">{d.intro}</p>
        <a class="button primary" href="https://apps.apple.com/app/id6774681432" data-store-link data-placement="release-23">{d.download}</a>
        <p class="small-note">{d.availability}</p>
      </div>
      <figure><img src={media+'front-scene.webp'} alt={d.heroAlt} width="1400" height="875" fetchpriority="high"/><figcaption>{d.heroNote}</figcaption></figure>
    </header>

    <section class="release-films" aria-labelledby="release-films-heading">
      <h2 id="release-films-heading">{d.films.title}</h2>
      <p>{d.films.note}</p>
      <div class="release-pair">
        {[['dualcam-field-demo', d.films.front], ['dualcam-duo-field-demo',d.films.duo]].map(([file,title])=>
          <figure><video controls playsinline preload="none" poster={media+file+'.webp'} width="1280" height="720" data-demo-id={file} aria-label={title}>
          <source src={media+file+'.mp4'} type="video/mp4"/>
          <track kind="captions" src={media+file+'-zh.vtt'} srclang="zh-Hans" label="简体中文" default={locale==='zh'}/>
          <track kind="captions" src={media+file+'-en.vtt'} srclang="en" label="English" default={locale==='en'}/>
          <track kind="captions" src={media+file+'-th.vtt'} srclang="th" label="ไทย" default={locale==='th'}/>
          </video><figcaption>{title}</figcaption></figure>)}
      </div>
    </section>

    {sections.map(({key,copy:s,images})=><section class="release-chapter" id={key}>
      <div class="release-copy"><h2>{s.title}</h2><p class="lead">{s.lead}</p><p>{s.body}</p>
        {key==='duo'&&<a class="text-link" href={home+'iphone-duo/'}>{d.duo.guide}</a>}
        {key==='camera'&&<p>{d.camera.result}</p>}
      </div>
      <div class:list={['release-pair release-captures', key==='duo'&&'duo-captures']}>
        {[s.left,s.right].map((caption,i)=><figure><img src={media+images[i]+'.webp'} alt={caption} loading="lazy"/><figcaption>{caption}</figcaption></figure>)}
      </div>
    </section>)}
    <ReleaseNotes title={d.notes.title} entries={d.notes.entries}/>
  </article>
</Layout>
<style>
.release-story{padding-block:clamp(40px,7vw,100px)}
.release-hero{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,68px);align-items:center}
.release-hero .eyebrow{margin:28px 0 12px}
.release-hero h1{font-size:clamp(2.5rem,5vw,5rem);line-height:1.04;letter-spacing:-.035em;margin:0}
.release-hero .intro{max-width:640px;margin:20px 0}
.release-hero figure,.release-pair figure{margin:0;min-width:0}
.release-hero img,.release-pair img,.release-pair video{display:block;width:100%;height:auto;border-radius:14px}
.release-films,.release-chapter{padding-block:clamp(32px,6vw,72px);border-top:1px solid rgba(155,170,157,.24);margin-top:clamp(32px,5vw,72px)}
.release-films h2,.release-chapter h2{font-size:clamp(1.8rem,3.4vw,3.2rem);line-height:1.14;margin:0 0 14px}
.release-films p,.release-copy p{margin:0 0 18px}
.release-copy{max-width:760px}
.release-copy .lead{font-size:1.15rem}
.release-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(14px,3vw,32px);margin-top:24px}
.release-captures{align-items:start}
.release-captures figure{padding:clamp(12px,2vw,24px);background:#161b1a;border-radius:18px}
.release-captures img{object-fit:contain;max-height:530px}
.release-hero figcaption,.release-pair figcaption{color:#b5c0bb;font-size:.875rem;line-height:1.5;margin:10px 0 0}
.release-films video{background:#171d1c}
@media(max-width:740px){.release-hero,.release-films .release-pair{grid-template-columns:1fr}.release-captures.duo-captures{grid-template-columns:1fr 1.4fr}}
</style>
