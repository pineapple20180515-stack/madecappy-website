---
import { blogLabels, dualcamBlogPath } from '../../lib/dualcam-blog.mjs';
import { scenePath } from '../../lib/dualcam-scenes.mjs';
import { locales, showcasePath } from '../../lib/dualcam-showcase/locales.mjs';
import Attribution from './Attribution.astro';
import '../../styles/dualcam-marketing.css';

const { article, locale } = Astro.props;
const copy = article.translations[locale];
const variants = Object.keys(article.translations);
const canonical = new URL(scenePath(locale, article.slug), Astro.site).href;
const videoLocale = article.shorts?.[locale] ? locale : 'en-US';
const short = article.shorts?.[videoLocale];
const videoVersions = Object.entries(article.mp4 ?? {}) as [string, string][];
const mp4 = article.mp4?.[locale] ?? article.mp4?.['en-US'];
const download = 'https://apps.apple.com/app/id6774681432';
const shortUrl = short ? 'https://www.youtube.com/shorts/' + short : undefined;
const embedUrl = short ? 'https://www.youtube-nocookie.com/embed/' + short + '?autoplay=1&playsinline=1&rel=0' : undefined;
const playLabel = copy.video;
const title = copy.searchTitle;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: copy.title,
  description: copy.description,
  datePublished: article.date,
  inLanguage: locale,
  mainEntityOfPage: canonical,
  image: new URL(article.cover, Astro.site).href,
  author: { '@type': 'Organization', name: 'DualCam', url: new URL('/dualcam/', Astro.site).href },
};
---
<!doctype html>
<html lang={locale} dir={locales[locale].dir || 'ltr'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={copy.description} />
  <link rel="canonical" href={canonical} />
  {variants.map(code => <link rel="alternate" hreflang={code} href={new URL(scenePath(code, article.slug), Astro.site).href} />)}
  <link rel="alternate" hreflang="x-default" href={new URL(scenePath('en-US', article.slug), Astro.site).href} />
  <link rel="icon" href="/dualcam/icon.png" />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={copy.title} />
  <meta property="og:description" content={copy.description} />
  <meta property="og:image" content={new URL(article.cover, Astro.site).href} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
</head>
<body>
  <header class="site-header">
    <div class="wrap nav-row">
      <a class="brand" href={showcasePath(locale)}><img src="/dualcam/icon.png" width="32" height="32" alt="" />DualCam</a>
      <details class="language-menu">
        <summary aria-label={locales[locale].name}>{locales[locale].name}</summary>
        <nav class="languages" aria-label={locales[locale].name}>
          {variants.map(code => <a href={scenePath(code, article.slug)} lang={code} hreflang={code} aria-current={code === locale ? 'page' : undefined}>{locales[code].name}</a>)}
        </nav>
      </details>
    </div>
  </header>
  <main class="wrap scene">
    <article class:list={{'has-short': Boolean(short || mp4), 'has-samples': Boolean(article.samples)}}>
      <header class="story-heading">
        <a class="back" href={dualcamBlogPath(locale)}>{blogLabels[locale]}</a>
        <h1>{copy.title}</h1>
      </header>
      {short && <figure class="short">
        <div class="short-player">
          <button type="button" class="short-play" data-scene-play aria-label={playLabel}>
            <img src={article.poster} width="480" height="854" alt="" />
            <span class="play-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" focusable="false"><path fill="currentColor" d="M8 4.8v14.4L19 12z" /></svg></span>
          </button>
          <template>
            <iframe src={embedUrl} title={playLabel} width="360" height="640" referrerpolicy="strict-origin-when-cross-origin" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
          </template>
        </div>
        <figcaption><a href={shortUrl} target="_blank" rel="noopener noreferrer">YouTube Shorts · <bdi lang={videoLocale}>{locales[videoLocale].name}</bdi> <span aria-hidden="true">↗</span></a></figcaption>
      </figure>}
      {mp4 && <figure class="short hosted" data-hosted-scene>
        <video controls playsinline preload="metadata" src={mp4} poster={article.poster} aria-label={copy.video} />
        <div class="video-languages" role="group" aria-label={copy.videoLanguage}>
          {videoVersions.map(([code, source]) => <button type="button" lang={code} data-video-source={source} aria-pressed={source === mp4 ? 'true' : 'false'}>{locales[code].name}</button>)}
        </div>
        <figcaption>{copy.videoNote}</figcaption>
      </figure>}
      <div class="story-copy">
        {copy.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        {article.output && <figure class="result">
          <img src={article.output} width={article.outputWidth ?? 720} height={article.outputHeight ?? 960} alt={copy.result} loading="lazy" decoding="async" />
          <figcaption>{copy.result}</figcaption>
        </figure>}
        {article.samples && <div class="sample-grid">
          {article.samples.map(({ src, poster }, index) => {
            const [label, caption] = copy.examples[index];
            return <figure>
              <video controls playsinline muted preload="none" src={src} poster={poster} aria-label={label} />
              <figcaption><h2>{label}</h2>{caption}</figcaption>
            </figure>;
          })}
        </div>}
        {copy.note && <p class="note">{copy.note}</p>}
        {copy.steps && <section class="steps"><h2>{copy.stepsTitle}</h2><p>{copy.steps}</p></section>}
        <a class="button primary" href={download} data-store-link data-placement={article.slug}>{copy.cta}</a>
        {copy.offerTitle && <section class="offer">
          <h2>{copy.offerTitle}</h2>
          <p>{copy.offerIntro}</p>
          <p>{copy.offerDeadline}</p>
        </section>}
        {article.relatedSlug && <p class="related"><a class="back" href={scenePath(locale, article.relatedSlug)}>{copy.related} <span aria-hidden="true">→</span></a></p>}
      </div>
    </article>
  </main>
  <Attribution />
  <script>
    for (const player of document.querySelectorAll('[data-hosted-scene]')) {
      const video = player.querySelector('video');
      const buttons = player.querySelectorAll<HTMLButtonElement>('[data-video-source]');
      if (!video) continue;
      for (const button of buttons) {
        button.addEventListener('click', () => {
          const source = button.dataset.videoSource;
          if (!source || button.getAttribute('aria-pressed') === 'true') return;
          video.src = source;
          for (const option of buttons) option.setAttribute('aria-pressed', String(option === button));
        });
      }
    }
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-scene-play]')) {
      const template = button.nextElementSibling;
      if (!(template instanceof HTMLTemplateElement)) continue;
      button.addEventListener('click', () => {
        const player = template.content.querySelector('iframe');
        if (player) {
          button.replaceWith(player);
          player.focus();
        }
      }, { once: true });
    }
  </script>
</body>
</html>
<style>
  .scene { max-width: 1000px; padding-block: clamp(30px, 6vw, 72px) 70px; color: #efeee3; }
  article { max-width: 680px; margin-inline: auto; }
  article.has-short { max-width: none; display: grid; grid-template-columns: minmax(0,1fr) minmax(230px,.53fr); grid-template-areas: "title player" "copy player"; grid-template-rows: auto 1fr; align-items: start; column-gap: clamp(24px,6vw,64px); }
  .story-heading { grid-area: title; }
  .story-copy { grid-area: copy; }
  h1 { margin-block: 18px 26px; font-size: clamp(2rem, 4.9vw, 3.8rem); line-height: 1.14; text-wrap: balance; overflow-wrap: anywhere; }
  p { margin-block: 0 1.05rem; font-size: 1.04rem; line-height: 1.85; }
  .back, .short a { color: #ebce86; text-decoration: underline; text-underline-offset: .2em; }
  .result { width: min(100%, 410px); margin: 28px auto; }
  .result img { display: block; width: 100%; height: auto; border-radius: 12px; }
  figcaption { text-align: center; margin-block-start: 8px; font-size: .85rem; color: #bcc8bb; }
  .note { color: #bcc8bb; font-size: .9rem; margin-block: 25px; padding-block: 10px; border-block: 1px solid #34463a; }
  .short { grid-area: player; width: min(100%,345px); margin: 0 auto; }
  article.has-samples { max-width: 820px; }
  .hosted video, .sample-grid video { display: block; width: 100%; border-radius: 14px; background: #101612; object-fit: contain; }
  .hosted video { aspect-ratio: 9/16; }
  .video-languages { display: flex; gap: 8px; margin-block-start: 10px; }
  .video-languages button { flex: 1; padding: 9px; border-radius: 8px; border: 1px solid #4d574c; background: #202622; color: inherit; font: inherit; cursor: pointer; }
  .video-languages button[aria-pressed="true"] { border-color: #ebce86; color: #ebce86; }
  .sample-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; margin-block-start: 22px; }
  .sample-grid figure, .offer { margin: 0; border-radius: 14px; padding: 12px; background: #171d19; border: 1px solid #39443b; }
  .sample-grid video { aspect-ratio: 3/4; }
  .sample-grid figcaption { text-align: start; }
  .sample-grid h2 { margin: 0 0 5px; font-size: 1rem; color: #efeee3; }
  .offer { margin-block-start: 24px; padding: clamp(14px,4vw,24px); }
  .offer h2, .steps h2 { margin-block-start: 0; }
  .offer p:last-child { margin-block-end: 0; }
  .related { margin-block-start: 24px; }
  .short-player { aspect-ratio: 9/16; border-radius: 14px; background: #101612; }
  .short-player iframe, .short-play { display: block; width: 100%; height: 100%; border: 0; border-radius: inherit; }
  .short-play { position: relative; padding: 0; overflow: hidden; cursor: pointer; background: #101612; }
  .short-play img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .play-icon { display: grid; place-items: center; position: absolute; inset: 50% auto auto 50%; transform: translate(-50%,-50%); border-radius: 14px; width: 68px; height: 48px; background: #c61e24; color: white; box-shadow: 0 2px 16px #0008; }
  .short-play:hover .play-icon { background: #a9171c; }
  .short-play:focus-visible { outline: 2px solid #ffd58b; outline-offset: 3px; }
  .language-menu { position: relative; z-index: 10; }
  .language-menu summary { cursor: pointer; padding: 8px 10px; }
  .language-menu .languages { position: absolute; inset-inline-end: 0; inset-block-start: 100%; display: grid; width: max-content; gap: 4px; padding: 9px; background: #202622; border: 1px solid #424b45; border-radius: 12px; }
  @media (max-width: 480px) {
    .sample-grid { grid-template-columns: minmax(0,1fr); }
  }
  @media (max-width: 700px) {
    article.has-short { grid-template-columns: minmax(0,1fr); grid-template-areas: "title" "player" "copy"; }
    .short { width: min(100%,310px); margin-block-end: 24px; }
  }
</style>
