---
import BaseLayout from '../../layouts/BaseLayout.astro';
import stories from '../../data/dualcam-christmas-story.json';
import { christmasStoryDate, christmasStoryCover, christmasStoryPath } from '../../lib/dualcam-christmas-story.mjs';
import { sceneArticles, scenePath } from '../../lib/dualcam-scenes.mjs';
import { dualcamBlogPath } from '../../lib/dualcam-blog.mjs';

const locale = 'zh-Hans';
const story = stories[locale];
---
<BaseLayout title="博客 · Cappy" description="通过拍摄场景和实际作品，看看 DualCam 等产品怎么用。" ogImage={sceneArticles[0]?.cover || christmasStoryCover}>
  <section class="max-w-[var(--width-reading)] mx-auto px-6 pt-12 pb-16">
    <h1 class="text-4xl md:text-5xl font-black mb-8">博客</h1>
    {sceneArticles.map(entry => {
      const content = entry.translations[locale];
      const href = scenePath(locale, entry.slug);
      return <article class="mb-6 rounded-2xl border border-ink-100 overflow-hidden grid md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
        <a href={href} tabindex="-1" aria-hidden="true" class="self-center">
          <img src={entry.cover} width="1200" height="900" alt="" class="block w-full h-auto" />
        </a>
        <div class="p-6 md:p-8 self-center">
          <p class="flex gap-x-3 text-sm text-ink-500">
            <a class="text-ios-blue hover:underline" href={dualcamBlogPath(locale)}>DualCam</a>
            <time datetime={entry.date}>{new Intl.DateTimeFormat('zh-CN', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(entry.date))}</time>
          </p>
          <h2 class="mt-3 mb-3 text-xl md:text-2xl font-bold leading-snug">
            <a class="hover:underline" href={href}>{content.title}</a>
          </h2>
          <p class="text-ink-500 leading-relaxed">{content.description}</p>
        </div>
      </article>;
    })}
    <article class="rounded-2xl border border-ink-100 overflow-hidden grid md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
      <a href={christmasStoryPath(locale)} tabindex="-1" aria-hidden="true" class="self-center">
        <img src={christmasStoryCover} width="1200" height="900" alt="" class="block w-full h-auto" />
      </a>
      <div class="p-6 md:p-8 self-center">
        <p class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-ink-500">
          <a class="text-ios-blue hover:underline" href={dualcamBlogPath(locale)}>DualCam</a>
          <time datetime={christmasStoryDate}>2026 年 11 月 24 日</time>
        </p>
        <h2 class="mt-3 mb-3 text-xl md:text-2xl font-bold leading-snug">
          <a class="hover:underline" href={christmasStoryPath(locale)}>{story.title}</a>
        </h2>
        <p class="text-ink-500 leading-relaxed">{story.description}</p>
      </div>
    </article>
  </section>
</BaseLayout>
