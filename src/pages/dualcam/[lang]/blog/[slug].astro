---
import SceneStory from '../../../../components/dualcam/SceneStory.astro';
import { sceneArticles } from '../../../../lib/dualcam-scenes.mjs';
import { defaultLocale, showcasePath } from '../../../../lib/dualcam-showcase/locales.mjs';

export function getStaticPaths() {
  return sceneArticles.flatMap(article => Object.keys(article.translations)
    .filter(locale => locale !== defaultLocale)
    .map(locale => ({
      params: { slug: article.slug, lang: showcasePath(locale).split('/')[2] },
      props: { article, locale },
    })));
}
const { article, locale } = Astro.props;
---
<SceneStory locale={locale} article={article} />
